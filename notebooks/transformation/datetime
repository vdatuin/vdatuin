from pyspark.sql.functions import col

def cast_column(df, column_name, target_type):
    """
    Cast a column to a different data type.

    Args:
        df (DataFrame): The DataFrame containing the column.
        column_name (str): The name of the column to cast.
        target_type (str): The target data type (e.g., 'int', 'double', 'string').

    Usage:
        df_casted = cast_column(df, "age", "int")
    """
    return df.withColumn(column_name, col(column_name).cast(target_type))

from pyspark.sql.functions import date_format

def format_date_column(df, column_name, format_string):
    """
    Format a date column according to a specified format.

    Args:
        df (DataFrame): The DataFrame containing the date column.
        column_name (str): The name of the date column to format.
        format_string (str): The date format string (e.g., 'yyyy-MM-dd').

    Usage:
        df_formatted_date = format_date_column(df, "created_at", "yyyy-MM-dd")
    """
    return df.withColumn(column_name, date_format(col(column_name), format_string))

from pyspark.sql.functions import to_date

def convert_to_date_column(df, column_name, format_string=None):
    """
    Convert a column to a date type, optionally using a specific format.

    Args:
        df (DataFrame): The DataFrame containing the column.
        column_name (str): The name of the column to convert.
        format_string (str, optional): The format used to parse the date string.

    Usage:
        df_date_converted = convert_to_date_column(df, "date_string", "yyyy-MM-dd")
    """
    if format_string:
        return df.withColumn(column_name, to_date(col(column_name), format_string))
    else:
        return df.withColumn(column_name, to_date(col(column_name)))

from pyspark.sql.functions import date_add

def add_days_to_date_column(df, column_name, days):
    """
    Add a number of days to a date column.

    Args:
        df (DataFrame): The DataFrame containing the date column.
        column_name (str): The name of the date column.
        days (int): The number of days to add.

    Usage:
        df_date_added = add_days_to_date_column(df, "start_date", 10)
    """
    return df.withColumn(column_name, date_add(col(column_name), days))
from pyspark.sql.functions import year, month, dayofweek, minute, second

def extract_date_component(df, column_name, component):
    """
    Extract a specific component from a date or timestamp column.

    Args:
        df (DataFrame): The DataFrame containing the date or timestamp column.
        column_name (str): The name of the column to extract from.
        component (str): The component to extract ('year', 'month', 'dayofweek', 'minute', 'second').

    Usage:
        df_year = extract_date_component(df, "timestamp", "year")
        df_month = extract_date_component(df, "timestamp", "month")
    """
    function_map = {
        'year': year,
        'month': month,
        'dayofweek': dayofweek,
        'minute': minute,
        'second': second
    }
    if component in function_map:
        return df.withColumn(component, function_map[component](col(column_name)))
    else:
        raise ValueError("Invalid date component specified")
