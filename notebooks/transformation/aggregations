def group_by_columns(df, *columns):
    """
    Group the DataFrame by the specified columns.

    Args:
        df (DataFrame): The DataFrame to be grouped.
        *columns (str): Column names to group by.

    Usage:
        grouped_data = group_by_columns(df, "column1", "column2")
    """
    return df.groupBy(*columns)

def aggregate_grouped_data(grouped_data, **aggregations):
    """
    Perform aggregation on the grouped data.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.
        **aggregations (dict): Key-value pairs where keys are the column names and values are the aggregation functions.

    Usage:
        result = aggregate_grouped_data(grouped_data, salary_avg='avg(salary)', max_age='max(age)')
    """
    return grouped_data.agg(aggregations)

def average_grouped_data(grouped_data, column_name):
    """
    Compute the average of a specified column over each group.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.
        column_name (str): The name of the column to compute the average.

    Usage:
        avg_result = average_grouped_data(grouped_data, "salary")
    """
    return grouped_data.avg(column_name)

def count_grouped_data(grouped_data):
    """
    Count the number of rows in each group.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.

    Usage:
        count_result = count_grouped_data(grouped_data)
    """
    return grouped_data.count()

def max_grouped_data(grouped_data, column_name):
    """
    Compute the maximum value of a specified column over each group.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.
        column_name (str): The name of the column to find the maximum value.

    Usage:
        max_result = max_grouped_data(grouped_data, "salary")
    """
    return grouped_data.max(column_name)

def sum_grouped_data(grouped_data, column_name):
    """
    Compute the sum of a specified column over each group.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.
        column_name (str): The name of the column to sum up.

    Usage:
        sum_result = sum_grouped_data(grouped_data, "salary")
    """
    return grouped_data.sum(column_name)

from pyspark.sql.functions import approx_count_distinct

def approx_count_distinct_column(df, column_name, rsd=None):
    """
    Calculate the approximate count of distinct items in a column.

    Args:
        df (DataFrame): The DataFrame.
        column_name (str): The column to calculate distinct counts.
        rsd (float): Relative standard deviation, a measure of accuracy. Lower values create higher accuracy, with increased computation.

    Usage:
        distinct_count = approx_count_distinct_column(df, "column1", 0.05)
    """
    return df.agg(approx_count_distinct(column_name, rsd))

from pyspark.sql.functions import avg

def average_column(df, column_name):
    """
    Compute the average of a specified column.

    Args:
        df (DataFrame): The DataFrame.
        column_name (str): The name of the column to compute the average.

    Usage:
        avg_result = average_column(df, "salary")
    """
    return df.select(avg(column_name))

from pyspark.sql.functions import sum

def sum_column(df, column_name):
    """
    Compute the sum of a specified column.

    Args:
        df (DataFrame): The DataFrame.
        column_name (str): The column to sum up.

    Usage:
        sum_result = sum_column(df, "salary")
    """
    return df.select(sum(column_name))

def group_by_columns_with_aggregations(df, group_columns, **aggregations):
    """
    Group the DataFrame by specified columns and perform multiple aggregations.

    Args:
        df (DataFrame): The DataFrame to be grouped and aggregated.
        group_columns (list): List of column names to group by.
        **aggregations (dict): Key-value pairs where keys are the new column names and values are the aggregation functions applied.

    Usage:
        result = group_by_columns_with_aggregations(df, ["department", "gender"], avg_salary=('salary', 'avg'), max_age=('age', 'max'))
    """
    return df.groupBy(*group_columns).agg(aggregations)

def aggregate_grouped_data_with_expressions(grouped_data, **expressions):
    """
    Perform complex aggregation on grouped data using expressions.

    Args:
        grouped_data (GroupedData): The grouped data from a DataFrame.
        **expressions (dict): Expressions for aggregating data, where keys are output column names and values are expressions or tuples defining the aggregation.

    Usage:
        result = aggregate_grouped_data_with_expressions(grouped_data, max_salary='max(salary)', avg_age=('age', 'avg'))
    """
    from pyspark.sql import functions as F
    exprs = {key: F.expr(value) if isinstance(value, str) else F.expr(value[1])(value[0]) for key, value in expressions.items()}
    return grouped_data.agg(exprs)

from pyspark.sql.functions import approx_count_distinct

def approx_count_distinct_column_advanced(df, column_name, rsd=0.05):
    """
    Calculate the approximate count of distinct items in a column with configurable accuracy.

    Args:
        df (DataFrame): The DataFrame.
        column_name (str): The column to calculate distinct counts.
        rsd (float): Relative standard deviation, a measure of accuracy. Lower values create higher accuracy, with increased computation.

    Usage:
        distinct_count = approx_count_distinct_column_advanced(df, "column1", rsd=0.01)  # Higher accuracy
    """
    return df.agg(approx_count_distinct(column_name, rsd))

from pyspark.sql.functions import sum

def sum_column_advanced(df, column_name, cast_to_type=None):
    """
    Compute the sum of a specified column, with an option to cast to a different data type.

    Args:
        df (DataFrame): The DataFrame.
        column_name (str): The column to sum up.
        cast_to_type (str): Optional, cast the column to a different data type before summing, e.g., 'double'.

    Usage:
        sum_result = sum_column_advanced(df, "salary", cast_to_type='double')
    """
    if cast_to_type:
        return df.select(sum(df[column_name].cast(cast_to_type)).alias('sum'))
    else:
        return df.select(sum(column_name).alias('sum'))





